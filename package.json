{
  "name": "botein",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "predev": "node scripts/ensure-env.mjs",
    "dev": "node --watch --env-file-if-exists=.env src/server.mjs",
    "start": "node --env-file-if-exists=.env src/server.mjs",
    "worker": "node --env-file-if-exists=.env scripts/worker.mjs",
    "pg-migrate": "node --env-file-if-exists=.env scripts/pg-migrate.mjs",
    "test": "node --test src/server.test.mjs",
    "backup": "node --env-file-if-exists=.env scripts/backup.mjs",
    "verify-backup": "node --env-file-if-exists=.env scripts/verify-backup.mjs",
    "check": "for f in src/*.mjs public/*.js scripts/*.mjs; do node --check \"$f\" || exit 1; done"
  }
}
