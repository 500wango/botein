# Botein deployment & runtime configuration
PORT=3187
HOST=127.0.0.1

# Storage driver: sqlite (default) or postgres (requires DATABASE_URL)
# DB_DRIVER=sqlite
# DATABASE_PATH=./data/botein.sqlite
# DATABASE_URL=postgres://user:pass@127.0.0.1:5432/botein

# Research worker execution mode: embedded (default) or external (run `npm run worker`)
# RESEARCH_WORKER_MODE=embedded
# WORKER_ID=worker-1
# WORKER_POLL_MS=2000

# Public deployment & reverse proxy security
# PUBLIC_BASE_URL=https://app.example.com
# ALLOWED_HOSTS=app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# TRUST_PROXY=1
# ALLOW_MULTI_ORG_REGISTER=1

# Product catalog & market scope configuration
# SUPPORTED_MARKETS=US
# SUPPORTED_CATEGORIES=LAUNDRY_PODS

# Secrets & key management (AES-256-GCM / remote KMS)
# KMS_MASTER_KEY=replace-with-32-byte-base64-or-hex-key
# KMS_ENDPOINT_URL=https://kms.example.com/v1
# KMS_ENDPOINT_TOKEN=replace-me

# Search & AI Model gateway
# SEARCH_BASE_URL=http://127.0.0.1:8888
# MODEL_BASE_URL=http://127.0.0.1:3425
# MODEL_API_KEY=replace-me
# MODEL_NAME=replace-me
# HEADLESS_RENDER=0
