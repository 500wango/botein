# Botein local-only development server. Model and search integrations are deferred.
PORT=3187
# Defaults to data/botein.sqlite, with legacy data/signalsniper.sqlite fallback.
# DATABASE_PATH=./data/botein.sqlite
# Free local search (docker compose up -d). Defaults to this address.
# SEARCH_BASE_URL=http://127.0.0.1:8888
# Model gateway: Anthropic-compatible. Falls back to ANTHROPIC_* variables.
# MODEL_BASE_URL=http://127.0.0.1:3425
# MODEL_API_KEY=replace-me
# MODEL_NAME=replace-me
